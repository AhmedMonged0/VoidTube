{
  "appId": "com.ahmedmonged.voidtube",
  "appName": "VoidTube",
  "webDir": "dist",
  "server": {
    "cleartext": true,
    "allowNavigation": [
      "voidtube-one.vercel.app",
      "*.invidious.f5.si",
      "*.googlevideo.com",
      "*.ytimg.com",
      "*.savenow.to",
      "loader.to",
      "api.allorigins.win",

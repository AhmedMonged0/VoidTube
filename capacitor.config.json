{
  "appId": "com.ahmedmonged.voidtube",
  "appName": "VoidTube",
  "webDir": "dist",
  "server": {
    "cleartext": true,
    "allowNavigation": [
      "*"
    ]
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    }
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  }
}
